<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_ros2_sdk_interfaces</name>
  <version>0.0.1</version>
  <description>Action and service definitions for the experimental px4_ros2_sdk flight SDK</description>
  <maintainer email="beat-kueng@gmx.net">Beat Kueng</maintainer>
  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/Auterion/px4-ros2-interface-lib</url>
  <url type="bugtracker">https://github.com/Auterion/px4-ros2-interface-lib/issues</url>

  <author email="nmarques@riis.com">Nuno Marques (RIIS, LLC)</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
